{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'Skipping npm; Flutter is installed during the build.'",
  "buildCommand": "bash scripts/build-flutter-web.sh",
  "outputDirectory": "mobile/build/web",
  "headers": [
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/flutter_bootstrap.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
